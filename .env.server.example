# ---------------------------------------------------------------------------
# Prop Guard SERVER-ONLY environment (historical market-data jobs)
# Copy to `.env.server` (git-ignored). Read only by `npm run data:*`
# (scripts/market-data.ts, Node). Expo never loads this file, so nothing here
# can end up in the mobile/web bundle.
#
# NEVER rename any of these to EXPO_PUBLIC_* and never import them in app code.
# ---------------------------------------------------------------------------

# Market data provider: "databento" (default when a key is set) or "mock" (SIMULATED, never verified).
MARKET_DATA_PROVIDER=databento

# Databento historical API key (https://databento.com → API keys).
DATABENTO_API_KEY=
# CME Globex MDP 3.0 (ES, MES, NQ, MNQ and other CME futures).
DATABENTO_DATASET=GLBX.MDP3

# Supabase project URL and SERVICE ROLE key — used to write historical_bars,
# historical_data_coverage, practice_scenarios and practice_scenario_candles
# (these tables have no client write policies). Without them the jobs run as
# an in-memory dry run.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
