# ---------------------------------------------------------------------------
# Prop Guard environment
# Copy to `.env` (never commit .env). Only EXPO_PUBLIC_* values are bundled
# into the app — NEVER put secret keys in EXPO_PUBLIC_* variables.
# Leave everything blank to run in Demo Mode with local data.
# ---------------------------------------------------------------------------

# Supabase (Project Settings → API). The anon key is safe for clients; RLS protects data.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# AI: "mock" (default, on-device, no key needed) or "remote" (Supabase Edge
# Function `ai-gateway`). Provider keys are set as Supabase secrets, NOT here:
#   supabase secrets set AI_PROVIDER=anthropic ANTHROPIC_API_KEY=...
#   supabase secrets set AI_PROVIDER=openai OPENAI_API_KEY=...
# AI Setup Check (chart vs saved rules) uses the `setup-validation` function and
# the OpenAI Responses API — also server-side secrets only:
#   supabase secrets set OPENAI_API_KEY=... OPENAI_VISION_MODEL=gpt-6-sol SETUP_CHECK_RATE_PER_HOUR=30
# With mock mode (or no Supabase), Setup Check runs a clearly-labelled DEMO analysis.
EXPO_PUBLIC_AI_MODE=mock

# RevenueCat PUBLIC SDK keys (optional; billing is mocked when blank)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Unlock Pro features during development. Defaults to true when RevenueCat is not configured.
EXPO_PUBLIC_DEV_UNLOCK_PRO=true

# Historical market data (Databento etc.) is downloaded SERVER-SIDE only.
# Its keys live in `.env.server` (see .env.server.example) — never here and
# never as EXPO_PUBLIC_* variables.
