{
  "expo": {
    "name": "Prop Guard",
    "slug": "prop-guard",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "propguard",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#090B0F",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.propguard.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Prop Guard uses your photo library so you can attach chart screenshots to trades and analyze setups.",
        "NSCameraUsageDescription": "Prop Guard uses the camera so you can capture chart screenshots for setup analysis."
      }
    },
    "android": {
      "package": "com.propguard.app",
      "adaptiveIcon": {
        "backgroundColor": "#090B0F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#090B0F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#4DA8FF"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Prop Guard uses your photo library so you can attach chart screenshots to trades and analyze setups."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    }
  }
}
